{
  "version": 2,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/app/overview", "permanent": false }
  ],
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/docs", "destination": "/api/index" },
    { "source": "/openapi.json", "destination": "/api/index" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/portfolio", "destination": "/portfolio.html" },
    { "source": "/payments_dashboard", "destination": "/payments_dashboard.html" },
    { "source": "/app/:path*", "destination": "/app/index.html" }
  ],
  "functions": {
    "api/index.py": { "memory": 1024, "maxDuration": 30, "includeFiles": "{src,data,config,docs,dbt,airflow}/**" }
  },
  "headers": [
    { "source": "/app/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/app/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
