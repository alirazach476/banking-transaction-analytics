# =============================================================================
# NovaBank Transaction Analytics Pipeline — Environment Configuration
# Copy to .env and adjust. NEVER commit .env.
# =============================================================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=novabank
POSTGRES_USER=novabank
POSTGRES_PASSWORD=novabank_dev_password

# Dataset volumes (demo defaults — scale up for portfolio-full run)
# Full portfolio targets: CUSTOMERS=100000 ACCOUNTS=150000 TRANSACTIONS=2000000
NUM_CUSTOMERS=5000
NUM_ACCOUNTS=7500
NUM_TRANSACTIONS=100000
NUM_BRANCHES=50
NUM_MERCHANTS=1000
NUM_CARDS=10000
NUM_TRANSFERS=15000
NUM_ATM_TRANSACTIONS=20000
NUM_CARD_TRANSACTIONS=40000

# Data quality injection rates (0.0 – 1.0)
DQ_DUPLICATE_RATE=0.01
DQ_MISSING_RATE=0.005
DQ_INVALID_STATUS_RATE=0.01

# Anomaly injection & detection
ANOMALY_INJECTION_RATE=0.02
ANOMALY_ZSCORE_THRESHOLD=3.0
ANOMALY_HIGH_AMOUNT_MULTIPLIER=15.0
ANOMALY_RAPID_WINDOW_MINUTES=10
ANOMALY_RAPID_COUNT_THRESHOLD=5
ISOLATION_FOREST_CONTAMINATION=0.02

# Pipeline
RANDOM_SEED=42
DATA_START_DATE=2023-01-01
DATA_END_DATE=2025-12-31
PIPELINE_MODE=full
WATERMARK_TOLERANCE_SECONDS=0

# Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=False
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
